# Vercel > Project > Settings > Environment Variables'a taşınır.
# Bu dosya değer içermez; asla commit'lenmez.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=

# #7 Salt-okunur lokal geliştirme (opsiyonel):
# Service key'i olmayan geliştirici anon key ile okuma yapabilir.
# Supabase Dashboard > Settings > API > anon public key.
SUPABASE_ANON_KEY=
