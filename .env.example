# Vercel > Project > Settings > Environment Variables'a taşınır.
# Bu dosya değer içermez; asla commit'lenmez.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# #29 Discord gece özeti (yalnız sunucu ucu okur; değer istemciye ASLA girmez):
# Gerçek webhook URL'i Vercel env'de tutulur; burası lokal --send denemeleri içindir.
DISCORD_WEBHOOK_URL=
# Vercel cron isteğini imzalar (api/notify.js Bearer kontrolü). Üretimde
# Vercel env'de tanımlıdır; CRON_SECRET tanımsızsa üretim ucu 503 ile kapalıdır.
CRON_SECRET=

# #7 Salt-okunur lokal geliştirme (opsiyonel):
# Service key'i olmayan geliştirici anon key ile okuma yapabilir.
# Supabase Dashboard > Settings > API > anon public key.
SUPABASE_ANON_KEY=
