{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/notify", "schedule": "0 18 * * *" },
    { "path": "/api/notify", "schedule": "0 19 * * *" },
    { "path": "/api/notify", "schedule": "0 20 * * *" },
    { "path": "/api/notify", "schedule": "0 21 * * *" },
    { "path": "/api/notify", "schedule": "0 22 * * *" },
    { "path": "/api/notify", "schedule": "0 23 * * *" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
